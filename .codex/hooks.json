{
  "description": "Project grilling Spec and SQL spatial-index review hooks; HTML preview is user-level.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/grilling_spec.py\"",
            "timeout": 5,
            "statusMessage": "Loading grilling Spec workflow"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/reid/.codex/hooks/html-preview/html_result_policy.py",
            "timeout": 5,
            "statusMessage": "Generating interactive HTML results"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/sql_spatial_index.py\"",
            "timeout": 15,
            "statusMessage": "Checking SQL spatial-index review"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/sql_spatial_index.py\"",
            "timeout": 15,
            "statusMessage": "Checking SQL spatial-index review"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/sql_spatial_index.py\"",
            "timeout": 15,
            "statusMessage": "Checking SQL spatial-index review"
          }
        ]
      }
    ]
  }
}
