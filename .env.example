# Copy this file to .env for local use. Never commit the copied file.

POSTGRES_HOST_PORT=15432
POSTGRES_PASSWORD=change-me

QDRANT_HOST_PORT=16333
ROADNET_SERVICES_NETWORK=roadnet-services

# Container paths for the complete, non-secret service configurations.
# Compose images include these files; changing either TOML requires recreating
# the affected service. Direct host execution may set an absolute host path.
PIPELINE_CONFIG_PATH=/app/config/pipeline.toml
BACKEND_CONFIG_PATH=/app/config/backend.toml

# All directory settings below are host-side paths.
# Container paths are fixed by Compose; no symlinks are needed.
DATA_ROOT=/data/tmp/road-network
# Optional overrides; unset/empty uses DATA_ROOT/parquet and DATA_ROOT/logs.
# PARQUET_ROOT=/another/host/directory/parquet
PIPELINE_LOG_DIR=/data/tmp/road-network/logs

# External model directory in production. For the repository-local ignored
# development copy, leave unset or use an absolute path to ./models.
MODEL_ROOT=/data/service-data/vision/models
YOLO_DEVICE=0
YOLO_IMGSZ=640
YOLO_BATCH=1
YOLO_HALF=True
YOLO_CONF=0.25

BACKEND_PORT=8000
FRONTEND_PORT=5173
