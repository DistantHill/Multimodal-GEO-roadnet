# Copy this file to .env for local use. Never commit the copied file.

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=15432
POSTGRES_DB=roadnet
POSTGRES_USER=roadnet
POSTGRES_PASSWORD=change-me

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HOST_PORT=16333

# Host-side runtime data directory. It is mounted into containers at /data.
DATA_ROOT=/data/road-network
PARQUET_ROOT=/data/road-network/parquet
# Container path; keep logs under the external /data mount.
PIPELINE_LOG_PATH=/data/logs/pipeline.log

# External model directory in production. For the repository-local ignored
# development copy, leave unset or use an absolute path to ./models.
MODEL_ROOT=/data/road-network/models
YOLO_DEVICE=0
YOLO_IMGSZ=640
YOLO_BATCH=1
YOLO_HALF=True
YOLO_CONF=0.25

BACKEND_PORT=8000
FRONTEND_PORT=5173
